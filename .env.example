# Copy this to .env and adjust for your environment.
# Defaults below work out of the box for local dev with sqlite.

DATABASE_URL=sqlite:///./siem.db
# For docker-compose / postgres:
# DATABASE_URL=postgresql+psycopg2://siem:siem_password@localhost:5432/siem

SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret that log-shipping agents must send in the X-API-Key header on POST /ingest
INGEST_API_KEY=replace-with-a-long-random-string

BRUTE_FORCE_ATTEMPT_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60
PORT_SCAN_PORT_THRESHOLD=10
PORT_SCAN_WINDOW_SECONDS=30
ANOMALY_MIN_EVENTS_FOR_SCORING=50
